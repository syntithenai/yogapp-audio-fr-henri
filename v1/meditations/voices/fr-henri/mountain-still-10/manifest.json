    {
      "index": 22,
      "text": "[pause : 57]",
      "file": "c022.ogg",
      "durationSec": 4.08
    },
    {
      "index": 23,
      "text": "Sentez la base de votre corps enracinée.",
      "file": "c023.ogg",
      "durationSec": 4.992
    },
    {
      "index": 24,
      "text": "Ressentez la hauteur de la colonne vertébrale sans effort.",
