    {
      "index": 15,
      "text": "[pause : 43]",
      "file": "c015.ogg",
      "durationSec": 3.672
    },
    {
      "index": 16,
      "text": "Le temps change à travers la montagne.",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "Soleil. Vent. Nuage. Tempête.",
