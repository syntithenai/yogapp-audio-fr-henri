{
  "id": "gratitude-5",
  "voiceId": "fr-henri",
  "edgeVoice": "fr-FR-HenriNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 143,
  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "Trouvez un siège confortable ou allongez-vous si vous vous sentez mieux.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Laissez les mains se reposer.",
      "file": "c002.ogg",
      "durationSec": 4.08
    },
    {
      "index": 3,
      "text": "Adoucissez les yeux ou fermez-les.",
      "file": "c003.ogg",
      "durationSec": 4.344
    },
    {
      "index": 4,
      "text": "Inspirez lentement.",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "Et une expiration plus longue.",
      "file": "c005.ogg",
      "durationSec": 4.128
    },
    {
      "index": 6,
      "text": "Rappelez-vous une petite chose qui vous a aidé aujourd’hui ou cette semaine.",
      "file": "c006.ogg",
      "durationSec": 6.984
    },
    {
      "index": 7,
      "text": "Cela peut être ordinaire. Eau tiède. Un message. Lumière sur un mur.",
      "file": "c007.ogg",
      "durationSec": 12.888
    },
    {
      "index": 8,
      "text": "[pause : 21]",
      "file": "c008.ogg",
      "durationSec": 3.456
    },
    {
      "index": 9,
      "text": "Tenez-le doucement en conscience.",
      "file": "c009.ogg",
      "durationSec": 4.536
    },
    {
      "index": 10,
      "text": "Remarquez tout ramollissement de la poitrine ou du visage.",
      "file": "c010.ogg",
      "durationSec": 6.24
    },
    {
      "index": 11,
      "text": "[pause : 26]",
      "file": "c011.ogg",
      "durationSec": 3.864
    },
    {
      "index": 12,
      "text": "En silence, remerciez cette chose.",
      "file": "c012.ogg",
      "durationSec": 5.352
    },
    {
      "index": 13,
      "text": "Merci d'être ici.",
      "file": "c013.ogg",
      "durationSec": 3.432
    },
    {
      "index": 14,
      "text": "[pause : 21]",
      "file": "c014.ogg",
      "durationSec": 3.456
    },
    {
      "index": 15,
      "text": "Maintenant une deuxième chose. Encore un petit bien.",
      "file": "c015.ogg",
      "durationSec": 7.56
    },
    {
      "index": 16,
      "text": "[pause : 26]",
      "file": "c016.ogg",
      "durationSec": 3.864
    },
    {
      "index": 17,
      "text": "Merci.",
      "file": "c017.ogg",
      "durationSec": 2.64
    },
    {
      "index": 18,
      "text": "[pause : 15]",
      "file": "c018.ogg",
      "durationSec": 3.336
    },
    {
      "index": 19,
      "text": "Et un de plus. Un troisième.",
      "file": "c019.ogg",
      "durationSec": 6.216
    },
    {
      "index": 20,
      "text": "[pause : 26]",
      "file": "c020.ogg",
      "durationSec": 3.864
    },
    {
      "index": 21,
      "text": "Que la gratitude soit simple. Pas forcé. Je viens de le remarquer.",
      "file": "c021.ogg",
      "durationSec": 10.392
    },
    {
      "index": 22,
      "text": "[pause : 31]",
      "file": "c022.ogg",
      "durationSec": 3.528
    },
    {
      "index": 23,
      "text": "Reposez-vous dans cette chaleur pendant quelques respirations.",
      "file": "c023.ogg",
      "durationSec": 6.408
    },
    {
      "index": 24,
      "text": "[pause : 41]",
      "file": "c024.ogg",
      "durationSec": 3.672
    },
    {
      "index": 25,
      "text": "Respirez encore une fois.",
      "file": "c025.ogg",
      "durationSec": 3.936
    },
    {
      "index": 26,
      "text": "Remuez les doigts.",
      "file": "c026.ogg",
      "durationSec": 3.12
    },
    {
      "index": 27,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c027.ogg",
      "durationSec": 5.064
    },
    {
      "index": 28,
      "text": "Emportez-en un peu avec vous.",
      "file": "c028.ogg",
      "durationSec": 3.96
    }
  ]
}
