      "text": "[pause : 23]",
      "file": "c008.ogg",
      "durationSec": 3.504
    },
    {
      "index": 9,
      "text": "Lorsque l’esprit s’égare, remarquez où il est allé.",
      "file": "c009.ogg",
      "durationSec": 6.216
    },
    {
      "index": 10,
      "text": "Puis revenez. Gentiment. Propre.",
