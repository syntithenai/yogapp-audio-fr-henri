    {
      "index": 6,
      "text": "Choisissez une ancre. Le souffle au niveau des narines, ou la montée du ventre.",
      "file": "c006.ogg",
      "durationSec": 9.792
    },
    {
      "index": 7,
      "text": "Restez attentif là-bas.",
