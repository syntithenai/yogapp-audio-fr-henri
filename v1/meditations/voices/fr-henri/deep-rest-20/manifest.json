      "durationSec": 5.472
    },
    {
      "index": 94,
      "text": "[pause : 21]",
      "file": "c094.ogg",
      "durationSec": 3.456
    },
    {
      "index": 95,
      "text": "Inspirez plus profondément.",
      "file": "c095.ogg",
      "durationSec": 4.032
    },
    {
      "index": 96,
      "text": "Et un long soupir.",
      "file": "c096.ogg",
      "durationSec": 3.384
    },
    {
      "index": 97,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c097.ogg",
      "durationSec": 5.064
    },
    {
      "index": 98,
      "text": "Revenez lentement.",
      "file": "c098.ogg",
      "durationSec": 3.288
    },
    {
      "index": 99,
      "text": "Emportez un peu de ce calme avec vous.",
      "file": "c099.ogg",
      "durationSec": 4.728
    }
  ]
