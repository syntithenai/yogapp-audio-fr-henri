      "durationSec": 4.008
    },
    {
      "index": 87,
      "text": "[pause : 23]",
      "file": "c087.ogg",
      "durationSec": 3.504
    },
    {
      "index": 88,
      "text": "Ressentez la pièce autour de vous.",
