  "chunks": [
    {
      "index": 0,
      "text": "Bienvenue dans une pratique de repos profond.",
      "file": "c000.ogg",
      "durationSec": 5.232
    },
    {
      "index": 1,
      "text": "Allongez-vous sur le dos si vous le pouvez.",
      "file": "c001.ogg",
      "durationSec": 4.776
    },
    {
      "index": 2,
      "text": "Soutenez la tête et les genoux si cela peut vous aider.",
      "file": "c002.ogg",
      "durationSec": 5.688
    },
    {
      "index": 3,
      "text": "Laissez les bras reposer à vos côtés, les paumes douces.",
      "file": "c003.ogg",
      "durationSec": 6.768
    },
    {
      "index": 4,
      "text": "Fermez les yeux.",
      "file": "c004.ogg",
      "durationSec": 3.024
    },
    {
      "index": 5,
      "text": "Il n'y a nulle part ailleurs où être.",
      "file": "c005.ogg",
      "durationSec": 4.104
    },
    {
      "index": 6,
      "text": "[pause : 23]",
      "file": "c006.ogg",
      "durationSec": 3.504
    },
    {
      "index": 7,
      "text": "Sentez les points de contact avec le sol ou le lit.",
      "file": "c007.ogg",
      "durationSec": 5.664
    },
    {
      "index": 8,
      "text": "Talons. Les hanches. Omoplates. Tête.",
      "file": "c008.ogg",
      "durationSec": 10.296
    },
    {
      "index": 9,
      "text": "Permettez au corps d’être tenu.",
      "file": "c009.ogg",
      "durationSec": 4.152
    },
    {
      "index": 10,
      "text": "[pause : 23]",
      "file": "c010.ogg",
      "durationSec": 3.504
    },
    {
      "index": 11,
      "text": "Remarquez la respiration naturelle.",
      "file": "c011.ogg",
      "durationSec": 4.896
    },
    {
      "index": 12,
      "text": "Pas besoin de le changer.",
      "file": "c012.ogg",
      "durationSec": 3.792
    },
    {
      "index": 13,
      "text": "L'inspiration arrive.",
      "file": "c013.ogg",
      "durationSec": 3.84
    },
    {
      "index": 14,
      "text": "Expirez les feuilles.",
      "file": "c014.ogg",
      "durationSec": 3.48
    },
    {
      "index": 15,
      "text": "[pause : 25]",
      "file": "c015.ogg",
      "durationSec": 3.696
    },
    {
      "index": 16,
      "text": "Si l’esprit est occupé, c’est permis.",
      "file": "c016.ogg",
      "durationSec": 5.184
    },
    {
      "index": 17,
      "text": "Tu peux quand même te reposer.",
      "file": "c017.ogg",
      "durationSec": 4.176
    },
    {
      "index": 18,
      "text": "Continuez simplement à revenir à la sensation.",
      "file": "c018.ogg",
      "durationSec": 5.544
    },
    {
      "index": 19,
      "text": "[pause : 23]",
      "file": "c019.ogg",
      "durationSec": 3.504
    },
    {
      "index": 20,
      "text": "Amenez la conscience du bon pied.",
      "file": "c020.ogg",
      "durationSec": 4.32
    },
    {
      "index": 21,
      "text": "Orteils. Seul. Talon.",
      "file": "c021.ogg",
      "durationSec": 7.32
    },
    {
      "index": 22,
      "text": "[pause : 21]",
      "file": "c022.ogg",
      "durationSec": 3.456
    },
    {
      "index": 23,
      "text": "Bas de jambe droit.",
      "file": "c023.ogg",
      "durationSec": 3.384
    },
    {
      "index": 24,
      "text": "Genou.",
      "file": "c024.ogg",
      "durationSec": 2.544
    },
    {
      "index": 25,
      "text": "Cuisse.",
      "file": "c025.ogg",
      "durationSec": 2.64
    },
    {
      "index": 26,
      "text": "[pause : 21]",
      "file": "c026.ogg",
      "durationSec": 3.456
    },
    {
      "index": 27,
      "text": "Hanche droite.",
      "file": "c027.ogg",
      "durationSec": 3.024
    },
    {
      "index": 28,
      "text": "Toute la jambe droite, lourde et silencieuse.",
      "file": "c028.ogg",
      "durationSec": 5.712
    },
    {
      "index": 29,
