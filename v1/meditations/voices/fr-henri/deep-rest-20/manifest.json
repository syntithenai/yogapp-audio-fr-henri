      "durationSec": 7.488
    },
    {
      "index": 70,
      "text": "[pause : 55]",
      "file": "c070.ogg",
      "durationSec": 4.056
    },
    {
      "index": 71,
      "text": "Si une pensée apparaît, laissez-la passer comme un nuage.",
      "file": "c071.ogg",
      "durationSec": 6.96
    },
    {
      "index": 72,
      "text": "[pause : 50]",
      "file": "c072.ogg",
      "durationSec": 3.744
    },
    {
      "index": 73,
      "text": "Revenez au sentiment d’être tenu.",
      "file": "c073.ogg",
      "durationSec": 4.536
    },
    {
      "index": 74,
      "text": "[pause : 55]",
      "file": "c074.ogg",
      "durationSec": 4.056
    },
    {
      "index": 75,
      "text": "Reposez-vous ici.",
      "file": "c075.ogg",
      "durationSec": 3.504
    },
    {
      "index": 76,
      "text": "Rien à résoudre.",
      "file": "c076.ogg",
      "durationSec": 3.36
    },
    {
      "index": 77,
      "text": "Rien à compléter.",
      "file": "c077.ogg",
      "durationSec": 3.456
    },
    {
      "index": 78,
      "text": "[pause : 110]",
      "file": "c078.ogg",
      "durationSec": 3.816
    },
    {
      "index": 79,
      "text": "Si vous dérivez, ce n'est pas grave.",
      "file": "c079.ogg",
      "durationSec": 4.968
    },
    {
      "index": 80,
      "text": "Si vous restez conscient, c'est bien aussi.",
      "file": "c080.ogg",
      "durationSec": 5.4
    },
    {
      "index": 81,
      "text": "Les deux sont au repos.",
      "file": "c081.ogg",
      "durationSec": 3.648
    },
    {
      "index": 82,
      "text": "[pause : 130]",
      "file": "c082.ogg",
      "durationSec": 3.864
    },
    {
      "index": 83,
      "text": "Repos.",
      "file": "c083.ogg",
      "durationSec": 2.616
    },
    {
      "index": 84,
      "text": "[pause : 115]",
      "file": "c084.ogg",
      "durationSec": 3.72
    },
    {
      "index": 85,
      "text": "Recommencez à remarquer la respiration.",
      "file": "c085.ogg",
      "durationSec": 5.232
    },
    {
      "index": 86,
      "text": "Un peu plus vivant maintenant.",
