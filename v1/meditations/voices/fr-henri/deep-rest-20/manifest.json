      "text": "[pause : 21]",
      "file": "c090.ogg",
      "durationSec": 3.456
    },
    {
      "index": 91,
      "text": "Remuez les doigts.",
      "file": "c091.ogg",
      "durationSec": 3.12
    },
    {
      "index": 92,
      "text": "Remuez les orteils.",
      "file": "c092.ogg",
      "durationSec": 3.696
    },
    {
      "index": 93,
      "text": "Roulez les poignets et les chevilles si vous le souhaitez.",
