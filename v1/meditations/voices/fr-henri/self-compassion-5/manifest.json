  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "Trouvez un siège confortable ou allongez-vous si vous vous sentez mieux.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Laissez les mains se reposer.",
      "file": "c002.ogg",
      "durationSec": 4.08
    },
    {
      "index": 3,
      "text": "Adoucissez les yeux ou fermez-les.",
      "file": "c003.ogg",
      "durationSec": 4.344
    },
    {
      "index": 4,
      "text": "Inspirez lentement.",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "Et une expiration plus longue.",
      "file": "c005.ogg",
      "durationSec": 4.128
    },
    {
      "index": 6,
      "text": "Placez une main sur le cœur ou posez les deux mains sur les genoux.",
      "file": "c006.ogg",
      "durationSec": 6.12
    },
    {
      "index": 7,
      "text": "Remarquez comment vous allez, sans le réparer.",
      "file": "c007.ogg",
      "durationSec": 5.664
    },
    {
      "index": 8,
      "text": "[pause : 31]",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "S’il y a une difficulté, reconnaissez-la.",
      "file": "c009.ogg",
      "durationSec": 5.832
    },
    {
      "index": 10,
      "text": "C'est un moment difficile.",
      "file": "c010.ogg",
      "durationSec": 3.936
    },
    {
      "index": 11,
      "text": "La difficulté fait partie de l’être humain.",
      "file": "c011.ogg",
      "durationSec": 5.112
    },
    {
      "index": 12,
      "text": "[pause : 39]",
      "file": "c012.ogg",
      "durationSec": 3.84
    },
    {
      "index": 13,
      "text": "Offrez-vous de la gentillesse comme vous l'offririez à un ami.",
      "file": "c013.ogg",
      "durationSec": 6.096
    },
    {
      "index": 14,
      "text": "Puis-je être gentil avec moi-même.",
      "file": "c014.ogg",
      "durationSec": 4.536
    },
    {
      "index": 15,
      "text": "Puis-je me donner la compassion dont j'ai besoin.",
      "file": "c015.ogg",
      "durationSec": 5.088
    },
    {
      "index": 16,
      "text": "[pause : 39]",
      "file": "c016.ogg",
      "durationSec": 3.84
    },
    {
      "index": 17,
      "text": "Encore une fois, lentement.",
      "file": "c017.ogg",
      "durationSec": 4.392
    },
    {
      "index": 18,
      "text": "Puis-je être gentil avec moi-même.",
      "file": "c018.ogg",
      "durationSec": 4.536
    },
    {
      "index": 19,
      "text": "Puis-je me donner la compassion dont j'ai besoin.",
      "file": "c019.ogg",
      "durationSec": 5.088
    },
    {
      "index": 20,
      "text": "[pause : 45]",
      "file": "c020.ogg",
      "durationSec": 3.888
    },
    {
      "index": 21,
      "text": "Respirez dans la main sur le cœur, s'il est là.",
      "file": "c021.ogg",
      "durationSec": 5.784
    },
    {
      "index": 22,
      "text": "[pause : 39]",
      "file": "c022.ogg",
      "durationSec": 3.84
    },
    {
      "index": 23,
      "text": "Vous n'êtes pas obligé de mériter cette douceur.",
      "file": "c023.ogg",
      "durationSec": 5.616
    },
    {
      "index": 24,
      "text": "Respirez encore une fois.",
      "file": "c024.ogg",
      "durationSec": 3.936
    },
    {
      "index": 25,
      "text": "Remuez les doigts.",
      "file": "c025.ogg",
      "durationSec": 3.12
    },
    {
      "index": 26,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c026.ogg",
      "durationSec": 5.064
    },
    {
      "index": 27,
      "text": "Emportez-en un peu avec vous.",
      "file": "c027.ogg",
      "durationSec": 3.96
    }
  ]
}
