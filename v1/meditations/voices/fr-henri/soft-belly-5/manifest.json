      "durationSec": 5.472
    },
    {
      "index": 17,
      "text": "[pause : 29]",
      "file": "c017.ogg",
      "durationSec": 3.84
    },
    {
      "index": 18,
      "text": "Les épaules tombent.",
      "file": "c018.ogg",
      "durationSec": 3.504
    },
    {
      "index": 19,
      "text": "Mâchoire douce.",
      "file": "c019.ogg",
      "durationSec": 3.456
    },
    {
      "index": 20,
      "text": "Ventre libre.",
      "file": "c020.ogg",
      "durationSec": 3.072
    },
    {
      "index": 21,
      "text": "[pause : 25]",
      "file": "c021.ogg",
      "durationSec": 3.696
    },
    {
      "index": 22,
      "text": "Restez avec dix respirations calmes et douces du ventre.",
