    },
    {
      "index": 8,
      "text": "[pause : 20]",
      "file": "c008.ogg",
      "durationSec": 3.024
    },
    {
      "index": 9,
      "text": "À l’inspiration suivante, laissez le ventre se dilater.",
      "file": "c009.ogg",
      "durationSec": 6.984
    },
    {
      "index": 10,
      "text": "À l’expiration, laissez-le retomber sans serrer.",
      "file": "c010.ogg",
      "durationSec": 6.144
    },
    {
      "index": 11,
      "text": "[pause : 20]",
      "file": "c011.ogg",
      "durationSec": 3.024
    },
    {
      "index": 12,
      "text": "Encore. Ventre mou dedans.",
      "file": "c012.ogg",
      "durationSec": 5.928
    },
    {
      "index": 13,
      "text": "Ventre mou.",
      "file": "c013.ogg",
      "durationSec": 2.832
    },
    {
      "index": 14,
      "text": "[pause : 25]",
      "file": "c014.ogg",
      "durationSec": 3.696
    },
    {
      "index": 15,
      "text": "Si l’esprit argumente, laissez le corps diriger.",
      "file": "c015.ogg",
      "durationSec": 6.264
    },
    {
      "index": 16,
      "text": "Expansion. Libérer.",
