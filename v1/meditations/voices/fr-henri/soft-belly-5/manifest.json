    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "Trouvez un siège confortable ou allongez-vous si vous vous sentez mieux.",
      "file": "c001.ogg",
      "durationSec": 6.792
    },
    {
      "index": 2,
      "text": "Laissez les mains se reposer.",
      "file": "c002.ogg",
      "durationSec": 4.08
    },
    {
      "index": 3,
      "text": "Adoucissez les yeux ou fermez-les.",
      "file": "c003.ogg",
      "durationSec": 4.344
    },
    {
      "index": 4,
      "text": "Inspirez lentement.",
      "file": "c004.ogg",
      "durationSec": 3.312
    },
    {
      "index": 5,
      "text": "Et une expiration plus longue.",
      "file": "c005.ogg",
      "durationSec": 4.128
    },
    {
      "index": 6,
      "text": "Posez une main sur le bas du ventre si vous le souhaitez.",
      "file": "c006.ogg",
      "durationSec": 5.88
    },
    {
      "index": 7,
      "text": "Remarquez si le ventre tient.",
