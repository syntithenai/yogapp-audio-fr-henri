  "chunks": [
    {
      "index": 0,
      "text": "Asseyez-vous confortablement. Adoucit le visage.",
      "file": "c000.ogg",
      "durationSec": 7.8
    },
    {
      "index": 1,
      "text": "Placez une main sur le cœur si cela peut aider.",
      "file": "c001.ogg",
      "durationSec": 5.4
    },
    {
      "index": 2,
      "text": "Nous vous proposerons des phrases simples de gentillesse.",
      "file": "c002.ogg",
      "durationSec": 5.904
    },
    {
      "index": 3,
      "text": "D’abord envers vous-même.",
      "file": "c003.ogg",
      "durationSec": 3.792
    },
    {
      "index": 4,
      "text": "Répétez silencieusement après moi, ou écoutez simplement.",
      "file": "c004.ogg",
      "durationSec": 6.912
    },
    {
      "index": 5,
      "text": "Puis-je être en sécurité.",
      "file": "c005.ogg",
      "durationSec": 3.912
    },
    {
      "index": 6,
      "text": "Puis-je aller bien.",
      "file": "c006.ogg",
      "durationSec": 2.928
    },
    {
      "index": 7,
      "text": "Puis-je être à l'aise.",
      "file": "c007.ogg",
      "durationSec": 3.288
    },
    {
      "index": 8,
      "text": "Répétez-les lentement.",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "Puis-je être en sécurité.",
      "file": "c009.ogg",
      "durationSec": 3.912
    },
    {
      "index": 10,
      "text": "Puis-je aller bien.",
      "file": "c010.ogg",
      "durationSec": 2.928
    },
    {
      "index": 11,
      "text": "Puis-je être à l'aise.",
      "file": "c011.ogg",
      "durationSec": 3.288
    },
    {
      "index": 12,
      "text": "Si cela semble difficile, ce n'est pas grave. Restez avec le souhait lui-même.",
      "file": "c012.ogg",
      "durationSec": 10.392
    },
    {
      "index": 13,
      "text": "Maintenant, pensez à quelqu’un dont il est facile de se soucier.",
      "file": "c013.ogg",
      "durationSec": 7.296
    },
    {
      "index": 14,
      "text": "Un ami, un animal de compagnie, un gentil étranger.",
      "file": "c014.ogg",
      "durationSec": 7.296
    },
    {
      "index": 15,
      "text": "Imaginez-les brièvement.",
      "file": "c015.ogg",
      "durationSec": 3.744
    },
    {
      "index": 16,
      "text": "Puissiez-vous être en sécurité.",
      "file": "c016.ogg",
      "durationSec": 4.368
    },
    {
      "index": 17,
      "text": "Puissiez-vous aller bien.",
      "file": "c017.ogg",
      "durationSec": 3.408
    },
    {
      "index": 18,
      "text": "Puissiez-vous être à l'aise.",
      "file": "c018.ogg",
      "durationSec": 3.72
    },
    {
      "index": 19,
      "text": "Une fois de plus.",
      "file": "c019.ogg",
      "durationSec": 3.48
    },
    {
      "index": 20,
      "text": "Puissiez-vous être en sécurité.",
      "file": "c020.ogg",
      "durationSec": 4.368
    },
    {
      "index": 21,
      "text": "Puissiez-vous aller bien.",
      "file": "c021.ogg",
      "durationSec": 3.408
    },
    {
      "index": 22,
      "text": "Puissiez-vous être à l'aise.",
      "file": "c022.ogg",
      "durationSec": 3.72
    },
    {
      "index": 23,
      "text": "Ressentez toute la chaleur qui surgit. Ou reposez-vous simplement sur les mots.",
      "file": "c023.ogg",
      "durationSec": 9.624
    },
    {
      "index": 24,
      "text": "Revenez à votre propre souffle.",
