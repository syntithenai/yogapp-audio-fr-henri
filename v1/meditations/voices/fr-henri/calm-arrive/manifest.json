{
  "id": "calm-arrive",
  "voiceId": "fr-henri",
  "edgeVoice": "fr-FR-HenriNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 100,
  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "Prenez un moment pour arriver.",
      "file": "c001.ogg",
      "durationSec": 4.056
    },
    {
      "index": 2,
      "text": "Trouvez un siège confortable ou allongez-vous si vous vous sentez mieux.",
      "file": "c002.ogg",
      "durationSec": 6.792
    },
    {
      "index": 3,
      "text": "Laissez vos mains se reposer.",
      "file": "c003.ogg",
      "durationSec": 4.104
    },
    {
      "index": 4,
      "text": "Laissez vos yeux se fermer ou adoucissez votre regard.",
      "file": "c004.ogg",
      "durationSec": 6.24
    },
    {
      "index": 5,
      "text": "Remarquez que vous êtes ici.",
      "file": "c005.ogg",
      "durationSec": 4.032
    },
    {
      "index": 6,
      "text": "Rien à réparer pour le moment.",
      "file": "c006.ogg",
      "durationSec": 4.032
    },
    {
      "index": 7,
      "text": "Rien à compléter.",
      "file": "c007.ogg",
      "durationSec": 3.456
    },
    {
      "index": 8,
      "text": "Inspirez lentement par le nez.",
      "file": "c008.ogg",
      "durationSec": 4.056
    },
    {
      "index": 9,
      "text": "Et une expiration plus longue.",
      "file": "c009.ogg",
      "durationSec": 4.128
    },
    {
      "index": 10,
      "text": "Encore. Inspirez doucement.",
      "file": "c010.ogg",
      "durationSec": 6.024
    },
    {
      "index": 11,
      "text": "Expirez doucement.",
      "file": "c011.ogg",
      "durationSec": 3.36
    },
    {
      "index": 12,
      "text": "Sentez le poids de votre corps soutenu.",
      "file": "c012.ogg",
      "durationSec": 4.848
    },
    {
      "index": 13,
      "text": "Le sol, la chaise, la terre qui vous retient.",
      "file": "c013.ogg",
      "durationSec": 6.48
    },
    {
      "index": 14,
      "text": "Si les pensées s’égarent, ce n’est pas grave.",
      "file": "c014.ogg",
      "durationSec": 5.592
    },
    {
      "index": 15,
      "text": "Remarquez simplement et revenez à cette respiration.",
      "file": "c015.ogg",
      "durationSec": 6.0
    },
    {
      "index": 16,
      "text": "Inhaler. Arriver.",
      "file": "c016.ogg",
      "durationSec": 5.064
    },
    {
      "index": 17,
      "text": "Exhaler. Régler.",
      "file": "c017.ogg",
      "durationSec": 5.184
    },
    {
      "index": 18,
      "text": "Encore une respiration facile.",
      "file": "c018.ogg",
      "durationSec": 4.656
    },
    {
      "index": 19,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c019.ogg",
      "durationSec": 5.064
    },
    {
      "index": 20,
      "text": "Emportez ce calme avec vous.",
      "file": "c020.ogg",
      "durationSec": 4.08
    }
  ]
}
