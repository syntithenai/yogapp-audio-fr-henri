      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "[pause : 33]",
      "file": "c012.ogg",
      "durationSec": 3.6
    },
    {
      "index": 13,
      "text": "Que la journée soit finie pour le moment.",
      "file": "c013.ogg",
      "durationSec": 4.584
    },
    {
      "index": 14,
      "text": "Ce qui est arrivé est arrivé.",
      "file": "c014.ogg",
      "durationSec": 4.32
    },
    {
      "index": 15,
      "text": "Ce qui reste peut attendre jusqu'au matin.",
      "file": "c015.ogg",
      "durationSec": 5.16
    },
    {
      "index": 16,
      "text": "[pause : 33]",
      "file": "c016.ogg",
      "durationSec": 3.6
    },
    {
      "index": 17,
      "text": "En expirant, imaginez placer des tâches sur une étagère.",
      "file": "c017.ogg",
      "durationSec": 7.056
    },
    {
      "index": 18,
      "text": "Un par un. Pas de drame. Asseyez-vous simplement.",
      "file": "c018.ogg",
      "durationSec": 8.88
    },
    {
      "index": 19,
      "text": "[pause : 53]",
      "file": "c019.ogg",
      "durationSec": 3.888
    },
    {
      "index": 20,
      "text": "Inspirez quatre. Expirez six.",
      "file": "c020.ogg",
      "durationSec": 6.672
    },
    {
      "index": 21,
      "text": "[pause : 33]",
      "file": "c021.ogg",
      "durationSec": 3.6
    },
    {
      "index": 22,
      "text": "Adoucit le visage.",
      "file": "c022.ogg",
      "durationSec": 3.744
    },
    {
      "index": 23,
      "text": "Baissez les épaules.",
      "file": "c023.ogg",
      "durationSec": 3.504
    },
    {
      "index": 24,
      "text": "Des armes lourdes. Jambes lourdes.",
