    },
    {
      "index": 7,
      "text": "[pause : 26]",
      "file": "c007.ogg",
      "durationSec": 3.864
    },
    {
      "index": 8,
      "text": "Encore.",
      "file": "c008.ogg",
      "durationSec": 2.784
    },
    {
      "index": 9,
      "text": "[pause : 26]",
      "file": "c009.ogg",
      "durationSec": 3.864
    },
    {
      "index": 10,
      "text": "Laissez les épaules tomber.",
      "file": "c010.ogg",
      "durationSec": 3.912
    },
    {
      "index": 11,
      "text": "Laissez le ventre ramollir.",
