    },
    {
      "index": 29,
      "text": "[pause :66]",
      "file": "c029.ogg",
      "durationSec": 4.2
    },
    {
      "index": 30,
      "text": "Respirez plus calmement. Corps plus lourd.",
      "file": "c030.ogg",
      "durationSec": 6.816
    },
    {
      "index": 31,
      "text": "[pause : 90]",
