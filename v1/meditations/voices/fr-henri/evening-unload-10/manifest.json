      "durationSec": 6.12
    },
    {
      "index": 25,
      "text": "[pause : 40]",
      "file": "c025.ogg",
      "durationSec": 3.6
    },
    {
      "index": 26,
      "text": "Si votre esprit réfléchit à nouveau, faites-y un signe de tête et retournez à l'étagère.",
      "file": "c026.ogg",
      "durationSec": 9.264
    },
    {
      "index": 27,
      "text": "[pause : 53]",
      "file": "c027.ogg",
      "durationSec": 3.888
    },
    {
      "index": 28,
      "text": "Sentez le matelas ou la chaise vous retenir.",
