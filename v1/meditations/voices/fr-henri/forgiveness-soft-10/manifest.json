  "chunks": [
    {
      "index": 0,
      "text": "Accueillir.",
      "file": "c000.ogg",
      "durationSec": 2.808
    },
    {
      "index": 1,
      "text": "Prenez le temps d'arriver.",
      "file": "c001.ogg",
      "durationSec": 3.552
    },
    {
      "index": 2,
      "text": "Asseyez-vous ou allongez-vous avec un soutien.",
      "file": "c002.ogg",
      "durationSec": 5.112
    },
    {
      "index": 3,
      "text": "Fermez les yeux si vous vous sentez en sécurité.",
      "file": "c003.ogg",
      "durationSec": 5.568
    },
    {
      "index": 4,
      "text": "Ressentez le contact avec le sol.",
      "file": "c004.ogg",
      "durationSec": 4.992
    },
    {
      "index": 5,
      "text": "Inspirez lentement.",
      "file": "c005.ogg",
      "durationSec": 3.312
    },
    {
      "index": 6,
      "text": "Expirez plus longtemps.",
      "file": "c006.ogg",
      "durationSec": 3.552
    },
    {
      "index": 7,
      "text": "[pause : 27]",
      "file": "c007.ogg",
      "durationSec": 3.768
    },
    {
      "index": 8,
      "text": "Encore.",
      "file": "c008.ogg",
      "durationSec": 2.784
    },
    {
      "index": 9,
      "text": "[pause : 27]",
      "file": "c009.ogg",
      "durationSec": 3.768
    },
    {
      "index": 10,
      "text": "Laissez les épaules tomber.",
      "file": "c010.ogg",
      "durationSec": 3.912
    },
    {
      "index": 11,
      "text": "Laissez le ventre ramollir.",
      "file": "c011.ogg",
      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "[pause : 34]",
      "file": "c012.ogg",
      "durationSec": 3.72
    },
    {
      "index": 13,
      "text": "Le pardon signifie ici relâcher son propre poing fermé.",
      "file": "c013.ogg",
      "durationSec": 6.528
    },
    {
      "index": 14,
      "text": "Ne pas prétendre qu’il y avait du mal n’avait pas d’importance.",
      "file": "c014.ogg",
      "durationSec": 6.576
    },
    {
      "index": 15,
      "text": "[pause : 34]",
      "file": "c015.ogg",
      "durationSec": 3.72
    },
    {
      "index": 16,
      "text": "Commencez par quelque chose de petit que vous avez contre vous-même.",
      "file": "c016.ogg",
      "durationSec": 6.864
    },
    {
      "index": 17,
      "text": "Une erreur. Une lacune.",
      "file": "c017.ogg",
      "durationSec": 5.616
    },
    {
      "index": 18,
      "text": "[pause : 34]",
      "file": "c018.ogg",
      "durationSec": 3.72
    },
    {
      "index": 19,
      "text": "En silence : je me pardonne d'être humain.",
      "file": "c019.ogg",
      "durationSec": 5.4
    },
    {
      "index": 20,
      "text": "Je libère ce que je n'ai plus besoin de porter.",
      "file": "c020.ogg",
      "durationSec": 5.4
    },
    {
      "index": 21,
      "text": "[pause : 54]",
      "file": "c021.ogg",
      "durationSec": 4.008
    },
    {
      "index": 22,
      "text": "Si cela vous convient, pensez à une légère difficulté avec un autre.",
      "file": "c022.ogg",
      "durationSec": 7.824
    },
    {
      "index": 23,
      "text": "Ce n’est pas l’histoire la plus difficile. Un plus léger.",
      "file": "c023.ogg",
      "durationSec": 7.632
    },
    {
      "index": 24,
      "text": "[pause : 34]",
      "file": "c024.ogg",
      "durationSec": 3.72
    },
    {
      "index": 25,
      "text": "Je libère ce que je peux.",
      "file": "c025.ogg",
      "durationSec": 3.768
    },
    {
      "index": 26,
      "text": "Je garde mes limites. J'ai perdu du poids supplémentaire.",
      "file": "c026.ogg",
      "durationSec": 8.232
    },
    {
      "index": 27,
      "text": "[pause : 54]",
      "file": "c027.ogg",
      "durationSec": 4.008
    },
    {
      "index": 28,
      "text": "Respirez dans les endroits qui se sont serrés.",
      "file": "c028.ogg",
      "durationSec": 5.136
    },
    {
      "index": 29,
      "text": "[pause : 68]",
      "file": "c029.ogg",
      "durationSec": 4.104
    },
    {
      "index": 30,
      "text": "Reposez-vous dans l'espace qui s'ouvre lorsque le poing se ramollit.",
      "file": "c030.ogg",
      "durationSec": 6.648
    },
    {
      "index": 31,
      "text": "[pause : 81]",
      "file": "c031.ogg",
      "durationSec": 3.672
    },
    {
      "index": 32,
      "text": "[pause : 41]",
      "file": "c032.ogg",
      "durationSec": 3.672
    },
    {
      "index": 33,
      "text": "Commencez à approfondir la respiration.",
      "file": "c033.ogg",
      "durationSec": 5.16
    },
    {
      "index": 34,
      "text": "Sentez à nouveau la pièce.",
      "file": "c034.ogg",
      "durationSec": 4.248
    },
    {
      "index": 35,
      "text": "Remuez les doigts et les orteils.",
      "file": "c035.ogg",
      "durationSec": 4.32
    },
    {
      "index": 36,
      "text": "Lorsque vous êtes prêt, ouvrez les yeux.",
      "file": "c036.ogg",
      "durationSec": 5.064
    },
    {
      "index": 37,
      "text": "Avancez lentement vers ce qui va suivre.",
      "file": "c037.ogg",
      "durationSec": 5.136
    }
  ]
